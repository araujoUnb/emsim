# emsim - Electromagnetic Simulator
# Python .gitignore for scientific computing project

# ============================================================================
# Python
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ============================================================================
# Virtual Environments
# ============================================================================

# Python virtual environments
venv/
ENV/
env/
.venv/
.ENV/
.env/
env.bak/
venv.bak/

# Conda environments
conda-meta/
.conda/

# ============================================================================
# IDEs and Editors
# ============================================================================

# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws
*.ipr

# Spyder
.spyderproject
.spyproject

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# ============================================================================
# Testing
# ============================================================================

# pytest
.pytest_cache/
.cache/
pytest.ini.bak

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
nosetests.xml
coverage/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ============================================================================
# Simulation Outputs
# ============================================================================

# Simulation results (keep structure, ignore data)
Simulations/*/outputs/*.csv
Simulations/*/outputs/*.yaml
Simulations/*/outputs/*.npy
Simulations/*/outputs/*.npz
Simulations/*/outputs/*.h5
Simulations/*/outputs/*.hdf5
Simulations/*/outputs/*.png
Simulations/*/outputs/*.jpg
Simulations/*/outputs/*.pdf
Simulations/*/outputs/*.gif
Simulations/*/outputs/*.mp4

# Keep the outputs directory structure with .gitkeep
!Simulations/*/outputs/.gitkeep

# Temporary simulation data
*.tmp
*.temp
*_temp.py
*_test.py
scratch/
tmp/
temp/

# ============================================================================
# Scientific Computing / Data
# ============================================================================

# Large data files
*.h5
*.hdf5
*.nc
*.mat
*.npy
*.npz
*.pkl
*.pickle

# Logs
*.log
logs/
*.out

# Plots and figures (optional - uncomment if you want to track them)
# *.png
# *.jpg
# *.pdf
# *.eps
# *.svg

# ============================================================================
# TensorFlow / ML
# ============================================================================

# TensorFlow checkpoints and saved models
checkpoints/
*.ckpt
*.ckpt.*
saved_models/
*.pb
*.pbtxt

# TensorBoard logs
tensorboard/
tb_logs/
runs/

# ============================================================================
# Documentation
# ============================================================================

# Sphinx documentation
docs/_build/
docs/_static/
docs/_templates/
site/

# LaTeX
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz

# ============================================================================
# OS Files
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ============================================================================
# Project Specific
# ============================================================================

# Claude/AI assistant temporary files
.claude/
tmpclaude-*

# Backup files
*.bak
*.backup
*.old
*~

# Configuration files with secrets (keep templates)
config.local.yaml
secrets.yaml
.env.local

# Performance profiling
*.prof
*.lprof
*.pyprof

# Database files (if any)
*.db
*.sqlite
*.sqlite3

# Compressed archives
*.zip
*.tar.gz
*.tar
*.rar
*.7z

# ============================================================================
# Keep Important Files
# ============================================================================

# Ensure these are tracked even if ignored above
!.gitignore
!.gitkeep
!README.md
!requirements*.txt
!pyproject.toml
!setup.py
!pytest.ini

# Keep example configs
!**/config.example.yaml
!**/config.template.yaml

# Keep test fixtures and data
!tests/fixtures/**
!tests/data/**
